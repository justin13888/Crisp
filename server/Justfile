# Crisp server task runner

# Format code
format:
    cargo fmt

# Check formatting without modifying files
format-check:
    cargo fmt --check

# Lint code
lint:
    cargo clippy -- -D warnings

# Lint and auto-fix
lint-fix:
    cargo clippy --fix --allow-dirty --allow-staged

# Run tests
test:
    cargo test

# Run tests with coverage report
coverage:
    cargo llvm-cov
