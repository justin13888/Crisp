# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
CRISP_DATABASE_URL=postgresql://crisp:crisp@localhost:5432/crisp

# 32-byte hex-encoded seed for the server's Composite ML-DSA endorsement key.
# Generate a fresh value with: openssl rand -hex 32
# WARNING: changing this in production rotates the platform identity.
CRISP_PLATFORM_SEED=<replace — openssl rand -hex 32>

# ── Optional (defaults shown) ─────────────────────────────────────────────────
#
# An empty value means unset, so the default applies. A value that is set but
# malformed stops the server at startup rather than falling back to a default.

# ── Database ──────────────────────────────────────────────────────────────────

# Connection-pool size.
CRISP_DB_MAX_CONNECTIONS=10

# Seconds a request waits for a pooled connection (including opening one)
# before it answers 503.
CRISP_DB_ACQUIRE_TIMEOUT_SECS=5

# Server-side statement_timeout in seconds on every connection, migrations
# included; a cancelled statement answers 503.
CRISP_DB_STATEMENT_TIMEOUT_SECS=30

# ── Platform key ──────────────────────────────────────────────────────────────

# Retired platform keys the server still holds, during a graceful rotation:
# comma-separated SEED_HEX@VALID_UNTIL entries (VALID_UNTIL in Unix seconds).
# Each is published after the current key with its valid_until, and signs the
# key set so clients that pinned it accept the new key (docs/deployment.md,
# "Rotation policy"). Never list a compromised seed here. Empty: none.
CRISP_PLATFORM_RETIRED_SEEDS=

# ── HTTP ──────────────────────────────────────────────────────────────────────

# HTTP listen address.
CRISP_BIND_ADDR=0.0.0.0:8080

# Comma-separated CORS origins, each scheme://host[:port] with no path, e.g.
# https://crisp.example,http://localhost:3000. Empty: any origin is allowed —
# only for local development; compose.prod.yaml requires it to be set.
CRISP_ALLOWED_ORIGINS=

# Maximum accepted .crisp bundle size in bytes (default 16 MiB).
CRISP_MAX_BUNDLE_BYTES=16777216

# Signature verifications and endorsements run at once; more wait their turn.
# Empty: the number of CPUs.
CRISP_VERIFY_CONCURRENCY=

# Seconds a client has to send a request head; also how long an idle
# keep-alive connection is kept.
CRISP_HEADER_TIMEOUT_SECS=30

# Seconds a request body may go without a byte arriving before the request is
# answered 408.
CRISP_BODY_IDLE_TIMEOUT_SECS=30

# Open connections; more wait in the accept backlog.
CRISP_MAX_CONNECTIONS=1024

# Concurrent HTTP/2 requests on one connection.
CRISP_MAX_STREAMS_PER_CONNECTION=100

# ── Reverse proxy ─────────────────────────────────────────────────────────────

# Comma-separated proxy addresses or address/prefix networks whose forwarding
# header names the client (README, "Reverse proxy and client addresses").
# Empty: no proxy is trusted, and the peer address is the client.
CRISP_TRUSTED_PROXIES=

# The header those proxies write: x-forwarded-for or forwarded (RFC 7239).
CRISP_PROXY_HEADER=x-forwarded-for

# ── Sessions ──────────────────────────────────────────────────────────────────

# Bearer token lifetime in seconds (default 30 days).
CRISP_SESSION_TTL_SECS=2592000

# Login challenge nonce lifetime in seconds (default 5 minutes).
CRISP_CHALLENGE_TTL_SECS=300

# Seconds between purges of expired sessions and challenges (default 10
# minutes).
CRISP_PURGE_INTERVAL_SECS=600

# ── Rate limits (REQUESTS/SECONDS) ────────────────────────────────────────────

# Registrations per client IP.
CRISP_LIMIT_REGISTER=10/3600

# Login challenges per username.
CRISP_LIMIT_CHALLENGE=10/300

# Login challenges per client IP, any username.
CRISP_LIMIT_CHALLENGE_PEER=30/60

# Logins per client IP.
CRISP_LIMIT_LOGIN=30/60

# Uploads per account.
CRISP_LIMIT_PUBLISH=60/3600

# Browse and search requests per client IP, shared.
CRISP_LIMIT_QUERY=120/60

# ── Storage quotas ────────────────────────────────────────────────────────────

# Endorsed bytes one account may store across all its revisions (default
# 256 MiB). At least CRISP_MAX_BUNDLE_BYTES, and set well above it, since the
# endorsed bundle is larger than the upload. Past it a publish answers 403.
CRISP_QUOTA_BYTES_PER_ACCOUNT=268435456

# Bundles (revisions) one account may store; past it a publish answers 403.
CRISP_QUOTA_BUNDLES_PER_ACCOUNT=5000

# Endorsed bytes the whole server may store; past it a publish answers 507.
# Empty: no cap.
CRISP_MAX_STORED_BYTES=

# ── Moderation ────────────────────────────────────────────────────────────────

# Comma-separated usr… ids of the accounts that may call the /admin moderation
# routes. Empty: none.
CRISP_ADMIN_USR_IDS=

# Where to report abuse or send a takedown notice (e-mail or web address),
# advertised by GET /server-info. Empty: none, and a WARN is logged at startup.
CRISP_ABUSE_CONTACT=

# The operator's terms of service (http(s) URL), advertised by
# GET /server-info and shown at registration. Empty: none, and a WARN is
# logged at startup.
CRISP_TERMS_URL=

# ── Logging and metrics ───────────────────────────────────────────────────────

# tracing-subscriber EnvFilter string.
RUST_LOG=info

# text for human-readable lines, json for one JSON object per event.
CRISP_LOG_FORMAT=text

# Listen address of the separate, unauthenticated Prometheus listener
# (GET /metrics); "off" disables it. Must differ from CRISP_BIND_ADDR.
CRISP_METRICS_BIND_ADDR=127.0.0.1:9464
