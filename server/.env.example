# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
CRISP_DATABASE_URL=postgresql://crisp:crisp@localhost:5432/crisp

# 32-byte hex-encoded seed for the server's Composite ML-DSA endorsement key.
# Generate a fresh value with: openssl rand -hex 32
# WARNING: changing this in production rotates the platform identity.
CRISP_PLATFORM_SEED=<replace — openssl rand -hex 32>

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Retired platform keys the server still holds, during a graceful rotation:
# comma-separated SEED_HEX@VALID_UNTIL entries (VALID_UNTIL in Unix seconds).
# Each is published after the current key with its valid_until, and signs the
# key set so clients that pinned it accept the new key (docs/deployment.md,
# "Rotation policy"). Never list a compromised seed here. Empty: none.
CRISP_PLATFORM_RETIRED_SEEDS=

# HTTP listen address.
CRISP_BIND_ADDR=0.0.0.0:8080

# Bearer token lifetime in seconds (default 30 days).
CRISP_SESSION_TTL_SECS=2592000

# Login challenge nonce lifetime in seconds (default 5 minutes).
CRISP_CHALLENGE_TTL_SECS=300

# Maximum accepted .crisp bundle size in bytes (default 16 MiB).
CRISP_MAX_BUNDLE_BYTES=16777216

# Set to "true" to enable permissive CORS — only for local development.
CRISP_CORS_PERMISSIVE=false

# ── Logging ───────────────────────────────────────────────────────────────────

# tracing-subscriber EnvFilter string.
RUST_LOG=info
